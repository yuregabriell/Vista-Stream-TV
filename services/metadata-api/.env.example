# Copy this file to .env ONLY on your private server.
# Never commit .env or put these values in the Android APK.
TMDB_API_KEY=your_tmdb_v3_key_here
# Generate a different strong random token for every device/account.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
VS_ACCESS_TOKENS=replace_with_random_access_token
# Leave disabled until the API license for the Vista Stream project permits it.
TVDB_API_KEY=
TVDB_LICENSED=false
